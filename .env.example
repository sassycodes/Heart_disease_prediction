# ── .env.example ──────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in REAL values.
# NEVER commit the real `.env` to git — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL credentials (used by Docker Compose AND the Python app)
POSTGRES_USER=heart_user
POSTGRES_PASSWORD=change_me_before_use
POSTGRES_DB=heart_disease
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
